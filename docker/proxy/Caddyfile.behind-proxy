# LibreVDI behind an existing reverse proxy that terminates TLS
# (e.g. Nginx Proxy Manager, Traefik, HAProxy with a valid certificate).
#
# Selected with LIBREVDI_PROXY_CONFIG=Caddyfile.behind-proxy in .env.
# The outer proxy forwards plain HTTP to this host on LIBREVDI_HTTP_PORT and must send
# Host, X-Forwarded-For and X-Forwarded-Proto (Nginx Proxy Manager does this by default).
#
# LIBREVDI_TRUSTED_PROXIES: IP(s) of the outer proxy whose X-Forwarded-* headers are trusted,
# e.g. "192.168.1.10/32". Only those can set the client IP. Do NOT use "private_ranges" in a LAN:
# every client would then count as a proxy and could fake its address. If unset, nothing is
# trusted and the broker sees the outer proxy's address for all clients.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static {$LIBREVDI_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Health endpoints are for container checks only
	@internal path /healthz /readyz
	respond @internal 404

	redir /favicon.ico /uds/res/modern/img/favicon.ico

	# No local CA in this mode: the outer proxy presents a publicly trusted certificate
	respond /ca.crt 404

	# The broker trusts exactly one proxy hop (this Caddy). Hand it the client IP that Caddy
	# derived from the outer proxy's headers instead of the whole forwarding chain.
	# In this mode the outer proxy always terminates TLS, so requests are HTTPS for the broker.
	# Restrict LIBREVDI_HTTP_PORT on the host firewall to the outer proxy.
	reverse_proxy broker-web:8000 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
	}
}
