# LibreVDI reverse proxy (Caddy)
#
# LIBREVDI_TLS:
#   internal               self-signed certificate from Caddy's local CA (lab / LAN)
#   you@example.com        automatic Let's Encrypt certificate (public DNS name required)
{
	admin off
}

{$LIBREVDI_DOMAIN} {
	tls {$LIBREVDI_TLS}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# Health endpoints are for container checks only
	@internal path /healthz /readyz
	respond @internal 404

	# Root certificate of Caddy's local CA (only exists with LIBREVDI_TLS=internal), so clients
	# and VMs can import it without copying files:
	#   curl.exe -k -o librevdi-ca.crt https://<domain>/ca.crt && certutil -addstore -f Root librevdi-ca.crt
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=librevdi-ca.crt"
		file_server
	}

	reverse_proxy broker-web:8000
}
