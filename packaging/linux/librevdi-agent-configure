#!/bin/sh
# LibreVDI Agent (unmanaged) for Linux: writes the agent configuration without the graphical
# configuration program, e.g. over SSH or from a provisioning script.
#
#   sudo librevdi-agent-configure --broker vdi.example.com [--no-verify-ssl] [--log-level warn]
#
# The service token of the LibreVDI service (Services -> Service -> Token) is read from standard
# input or asked for, never taken from the command line (it would be visible in the process list):
#
#   sudo librevdi-agent-configure --broker vdi.example.com < token.txt
#
# Writes /etc/udsactor/udsactor.cfg (TOML, mode 0600) in the format of the agent
# (upstream/uds-actor: crates/shared/src/unix/config.rs, struct ActorConfiguration) and restarts
# the agent service (udsactor-unmanaged.service).
set -eu

CONFIG_DIR=${LIBREVDI_AGENT_CONFIG_DIR:-/etc/udsactor}
broker=""
verify_ssl=true
log_level=warn
net=""
restart=1

usage() {
  sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --broker) broker=${2:-}; shift 2 ;;
    --broker=*) broker=${1#*=}; shift ;;
    --no-verify-ssl) verify_ssl=false; shift ;;
    --log-level) log_level=${2:-}; shift 2 ;;
    --log-level=*) log_level=${1#*=}; shift ;;
    --net) net=${2:-}; shift 2 ;;
    --net=*) net=${1#*=}; shift ;;
    --no-restart) restart=0; shift ;;
    -h|--help) usage 0 ;;
    *) echo "unknown option: $1" >&2; usage 2 ;;
  esac
done

host=$(printf '%s' "$broker" | sed -e 's|^[a-zA-Z]*://||' -e 's|/.*$||')
case "$host" in
  ""|*[!A-Za-z0-9.:-]*) echo "--broker needs a host name (e.g. vdi.example.com), got '$broker'" >&2; exit 2 ;;
esac
case "$log_level" in
  debug) level=20000 ;; info) level=30000 ;; warn|warning) level=40000 ;;
  error) level=50000 ;; fatal) level=60000 ;;
  *) echo "--log-level must be debug, info, warn, error or fatal" >&2; exit 2 ;;
esac
case "$net" in
  *[!0-9./]*) echo "--net must be a network like 10.0.0.0/8" >&2; exit 2 ;;
esac

if [ -t 0 ]; then
  printf 'Service token: ' >&2
  stty -echo 2>/dev/null || true
  IFS= read -r token || token=""
  stty echo 2>/dev/null || true
  echo >&2
else
  IFS= read -r token || true
fi
token=$(printf '%s' "${token:-}" | tr -d '[:space:]')
case "$token" in
  ""|*[!A-Za-z0-9_-]*) echo "service token is empty or has unexpected characters" >&2; exit 2 ;;
esac

[ "$(id -u)" -eq 0 ] || [ -n "${LIBREVDI_AGENT_CONFIG_DIR:-}" ] || { echo "run as root (sudo)" >&2; exit 1; }

umask 077
mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"
tmp="$CONFIG_DIR/.udsactor.cfg.$$"
{
  echo "broker_url = \"https://$host/uds/rest/\""
  echo "verify_ssl = $verify_ssl"
  echo "actor_type = \"unmanaged\""
  echo "master_token = \"$token\""
  [ -n "$net" ] && echo "restrict_net = \"$net\""
  echo "log_level = $level"
  echo ""
  echo "[config]"
} >"$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$CONFIG_DIR/udsactor.cfg"
echo "LibreVDI Agent configured for broker $host (unmanaged, verify_ssl=$verify_ssl, log level $log_level)"

if [ "$restart" -eq 1 ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  # unit of the unmanaged package; the managed package names it udsactor.service
  unit=udsactor-unmanaged.service
  systemctl cat "$unit" >/dev/null 2>&1 || unit=udsactor.service
  systemctl enable "$unit" >/dev/null 2>&1 || true
  systemctl restart "$unit" && echo "agent service ($unit) restarted"
fi
