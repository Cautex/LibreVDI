# LibreVDI configuration – copy to .env and replace ALL placeholders.
# Never commit your .env file.

# Public DNS name of the broker (used for TLS and links)
LIBREVDI_DOMAIN=vdi.example.lan
# "internal" = self-signed (lab/LAN), or an e-mail address for Let's Encrypt
LIBREVDI_TLS=internal

# Behind an existing reverse proxy with a valid certificate (e.g. Nginx Proxy Manager):
#   LIBREVDI_PROXY_CONFIG=Caddyfile.behind-proxy
#   LIBREVDI_TRUSTED_PROXIES=192.168.1.10/32   # exact IP of the outer proxy
# The outer proxy then forwards http://<docker-host>:LIBREVDI_HTTP_PORT
#LIBREVDI_PROXY_CONFIG=Caddyfile
#LIBREVDI_TRUSTED_PROXIES=192.168.1.10/32

# Database (choose a long random password, e.g. `openssl rand -base64 32`)
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Super user of the broker admin interface
LIBREVDI_ROOT_USER=root
LIBREVDI_ROOT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Optional
#LIBREVDI_TIME_ZONE=Europe/Berlin
#LIBREVDI_LANGUAGE=de
#LIBREVDI_LOG_LEVEL=INFO
#LIBREVDI_LOG_FORMAT=json
#LIBREVDI_HTTP_PORT=80
#LIBREVDI_HTTPS_PORT=443
#LIBREVDI_BROKER_IMAGE=librevdi-broker:local
#LIBREVDI_BACKEND_SUBNET=172.30.231.0/24
#POSTGRES_MAX_CONNECTIONS=200

# Tunnel (optional): start with  docker compose --profile tunnel up -d
# Address and port clients use to reach the tunnel (TCP and UDP, default: LIBREVDI_DOMAIN:4443)
#LIBREVDI_TUNNEL_HOST=vdi.example.lan
#LIBREVDI_TUNNEL_PORT=4443

# Signing of .rdp files: own certificate instead of the generated one (PEM cert+key or PFX)
#LIBREVDI_RDP_SIGN_CERT=/run/secrets/rdp-sign.pem
#LIBREVDI_RDP_SIGN_KEY=/run/secrets/rdp-sign.key

# Self-test of the LibreVDI extensions on every start (ADR-0008): strict = broker-init stops when an
# OpenUDS change broke an extension; warn = only log it (e.g. while a hook is being fixed)
#LIBREVDI_SELFCHECK=strict
